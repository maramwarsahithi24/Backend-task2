<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>SyntexHub</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Segoe UI", sans-serif;
}

body {
  min-height: 100vh;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #aaffcc;
  background:
    radial-gradient(circle at 20% 20%, rgba(0,255,140,0.25), transparent 35%),
    radial-gradient(circle at 80% 30%, rgba(0,200,120,0.2), transparent 40%),
    radial-gradient(circle at 50% 80%, rgba(0,255,180,0.18), transparent 45%),
    linear-gradient(135deg, #03130b, #000);
}

body::before {
  content: "";
  position: fixed;
  inset: -40%;
  background:
    radial-gradient(circle, rgba(0,255,160,0.18), transparent 60%);
  animation: bgFloat 18s ease-in-out infinite;
  z-index: -1;
}

@keyframes bgFloat {
  0%   { transform: translate(0, 0); }
  50%  { transform: translate(-6%, -4%); }
  100% { transform: translate(0, 0); }
}

.container {
  width: 420px;
  padding: 40px;
  border-radius: 22px;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(18px);
  border: 1px solid rgba(0, 255, 136, 0.7);
  box-shadow:
    0 0 35px rgba(0, 255, 136, 0.7),
    0 0 120px rgba(0, 255, 136, 0.5),
    inset 0 0 40px rgba(0, 255, 136, 0.3);
  animation: glowPulse 3s ease-in-out infinite,
             fadeUp 0.8s ease;
  text-align: center;
}

@keyframes glowPulse {
  0% {
    box-shadow:
      0 0 35px rgba(0, 255, 136, 0.7),
      0 0 120px rgba(0, 255, 136, 0.5),
      inset 0 0 40px rgba(0, 255, 136, 0.3);
  }
  50% {
    box-shadow:
      0 0 65px rgba(0, 255, 136, 1),
      0 0 160px rgba(0, 255, 136, 0.9),
      inset 0 0 55px rgba(0, 255, 136, 0.45);
  }
  100% {
    box-shadow:
      0 0 35px rgba(0, 255, 136, 0.7),
      0 0 120px rgba(0, 255, 136, 0.5),
      inset 0 0 40px rgba(0, 255, 136, 0.3);
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(25px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

h1 {
  font-size: 32px;
  margin-bottom: 12px;
  color: #00ff88;
  text-shadow: 0 0 22px #00ff88;
}

.tagline {
  font-size: 14px;
  margin-bottom: 28px;
  color: #9fffd0;
  opacity: 0.9;
}

.features {
  text-align: left;
  margin-bottom: 28px;
}

.features p {
  margin-bottom: 12px;
  font-size: 14px;
}

.features span {
  color: #00ff88;
  font-weight: bold;
}

.actions {
  display: flex;
  gap: 14px;
}

button {
  flex: 1;
  padding: 12px;
  border: none;
  border-radius: 10px;
  background: linear-gradient(90deg, #00ff88, #00cc66);
  color: #000;
  font-weight: bold;
  cursor: pointer;
  transition: 0.3s;
}

button:hover {
  box-shadow: 0 0 30px #00ff88;
  transform: translateY(-2px);
}

.logout {
  background: transparent;
  color: #00ff88;
  border: 1px solid #00ff88;
}

.logout:hover {
  background: #00ff88;
  color: #000;
}
</style>
</head>

<body>

<div class="container">
  <h1>SyntexHub</h1>
  <p class="tagline">Learn • Build • Grow</p>

  <div class="features">
    <p>🚀 <span>Practice</span> coding with real examples</p>
    <p>📘 <span>Learn</span> concepts step-by-step</p>
    <p>🧠 <span>Improve</span> problem-solving skills</p>
    <p>🌐 <span>Build</span> projects confidently</p>
  </div>

  <div class="actions">
    <button>Start Learning</button>
    <a href="/logout" style="flex:1">
      <button class="logout">Logout</button>
    </a>
  </div>
</div>

</body>
</html>
