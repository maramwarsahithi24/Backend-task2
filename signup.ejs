<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Signup</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Segoe UI", sans-serif;
}

body {
  min-height: 100vh;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #aaffcc;
  background:
    radial-gradient(circle at 20% 20%, rgba(0,255,140,0.25), transparent 35%),
    radial-gradient(circle at 80% 30%, rgba(0,200,120,0.2), transparent 40%),
    radial-gradient(circle at 50% 80%, rgba(0,255,180,0.18), transparent 45%),
    linear-gradient(135deg, #03130b, #000);
}

body::before {
  content: "";
  position: fixed;
  inset: -40%;
  background:
    radial-gradient(circle, rgba(0,255,160,0.18), transparent 60%);
  animation: bgFloat 18s ease-in-out infinite;
  z-index: -1;
}

@keyframes bgFloat {
  0%   { transform: translate(0, 0); }
  50%  { transform: translate(-6%, -4%); }
  100% { transform: translate(0, 0); }
}

.auth-box {
  width: 380px;
  padding: 34px;
  border-radius: 18px;
  background: rgba(0, 0, 0, 0.65);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(0, 255, 136, 0.7);
  box-shadow:
    0 0 30px rgba(0, 255, 136, 0.7),
    0 0 90px rgba(0, 255, 136, 0.45),
    inset 0 0 35px rgba(0, 255, 136, 0.3);
  animation: glowPulse 3s ease-in-out infinite;
}

@keyframes glowPulse {
  0% {
    box-shadow:
      0 0 30px rgba(0, 255, 136, 0.7),
      0 0 90px rgba(0, 255, 136, 0.45),
      inset 0 0 35px rgba(0, 255, 136, 0.3);
  }
  50% {
    box-shadow:
      0 0 55px rgba(0, 255, 136, 1),
      0 0 140px rgba(0, 255, 136, 0.9),
      inset 0 0 45px rgba(0, 255, 136, 0.45);
  }
  100% {
    box-shadow:
      0 0 30px rgba(0, 255, 136, 0.7),
      0 0 90px rgba(0, 255, 136, 0.45),
      inset 0 0 35px rgba(0, 255, 136, 0.3);
  }
}

h2 {
  text-align: center;
  margin-bottom: 26px;
  color: #00ff88;
  text-shadow: 0 0 18px #00ff88;
}

label {
  font-size: 14px;
  margin-bottom: 6px;
  display: block;
}

input {
  width: 100%;
  padding: 12px;
  margin-bottom: 18px;
  border-radius: 8px;
  border: 1px solid #00ff88;
  background: transparent;
  color: #aaffcc;
  outline: none;
}

input:focus {
  box-shadow: 0 0 14px #00ff88;
}

button {
  width: 100%;
  padding: 12px;
  border: none;
  border-radius: 8px;
  background: linear-gradient(90deg, #00ff88, #00cc66);
  color: #000;
  font-weight: bold;
  cursor: pointer;
  transition: 0.3s;
}

button:hover {
  box-shadow: 0 0 30px #00ff88;
  transform: translateY(-2px);
}
</style>
</head>

<body>


<div class="auth-box">
  <h2>Signup</h2>

  <form action="/authorization/signup" method="POST">
    <label>Username</label>
    <input type="text" name="username" placeholder="Enter username" required>

    <label>Email</label>
    <input type="email" name="email" placeholder="Enter email" required>

    <label>Password</label>
    <input type="password" name="password" placeholder="Enter password" required>

    <button type="submit">Signup</button>
  </form>
</div>

</body>
</html>